datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model ProductType {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model ProductVariant {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id           Int      @id @default(autoincrement())
  name         String
  
  typeId       Int?
  type         ProductType? @relation(fields: [typeId], references: [id])
  
  variantId    Int?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  
  description  String?
  images       ProductImage[]
  isBestSeller Boolean  @default(false)
  isFavorite   Boolean  @default(false)
  costPrice    Int      @default(0)
  price        Int
  discountPrice Int?
  stock        Int      @default(0)
  priority     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryLogs InventoryLog[]
}

model InventoryLog {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String   // "IN", "OUT", "RESET"
  quantity  Int
  giver     String?
  receiver  String?
  notes     String?  // Alasan / Komentar
  createdAt DateTime @default(now())
}

model Expense {
  id        Int      @id @default(autoincrement())
  name      String
  amount    Int
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  shiftId   Int?
  shift     Shift?   @relation(fields: [shiftId], references: [id])
}

model Shift {
  id           Int      @id @default(autoincrement())
  startTime    DateTime @default(now())
  endTime      DateTime?
  status       String   @default("Open") // Open, Closed
  initialCash  Int      @default(0)
  expectedCash Int?
  actualCash   Int?
  openedBy     String
  closedBy     String?
  transactions Transaction[]
  expenses     Expense[]
}

model Transaction {
  id            Int      @id @default(autoincrement())
  customer      String
  customerEmail String?
  customerPhone String?
  amount        Int
  status        String   @default("Waiting Payment")
  cashierName   String?
  paidAmount    Int?
  paymentMethod String?
  selfieUrl     String?
  cancelReason  String?
  
  preparedAt    DateTime?
  readyAt       DateTime?
  pickedUpAt    DateTime?
  
  createdAt     DateTime @default(now())
  items         TransactionItem[]

  shiftId       Int?
  shift         Shift?   @relation(fields: [shiftId], references: [id])
}

model TransactionItem {
  id            Int      @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     Int?
  productName   String
  quantity      Int
  price         Int
  costPrice     Int      @default(0)
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

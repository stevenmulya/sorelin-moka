# Database Connection (SQLite lokal, file ada di folder prisma/)
DATABASE_URL="file:./dev.db"

# Turso Cloud Database (untuk deployment di Vercel / Cloud)
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# --- Keamanan ---
# Wajib, minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-dengan-password-kuat"
KIOSK_USERNAME="customer"
KIOSK_PASSWORD="ganti-dengan-password-kiosk"
# Set "true" hanya jika diakses lewat HTTPS (di LAN HTTP biasa biarkan "false")
COOKIE_SECURE="false"

# Opsional: lokasi penyimpanan foto upload (default: folder ./uploads di root proyek)
# UPLOAD_DIR=""
